{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bigbuilds",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "public",
		"binding": "ASSETS"
	},
	// Thursdays, 13:00 UTC (~8am Central). Cut from every other day
	// (day-of-month */2) on 2026-10-09: every podcast shares one ElevenLabs
	// Creator plan and the total was well over its 100k credits/month.
	// Day NAMES, never numbers: Cloudflare cron weekdays are 1 = Sunday.
	// Keep stl-dispatcher's reconcile.js declaration identical.
	"triggers": {
		"crons": [
			"0 13 * * THU"
		]
	},
	"r2_buckets": [
		{
			"binding": "PODCAST_BUCKET",
			"bucket_name": "big-builds-podcast"
		}
	],
	// Workers AI binding for optional cover art (poster.js no-ops cleanly if omitted)
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"SHOW_NAME": "Big Builds",
		"SHOW_AUTHOR": "Big Builds",
		"SHOW_SITE_URL": "https://builds.stluker.com",
		"COVER_IMAGE_KEY": "cover.jpg"
	}
	// Secrets (set via `wrangler secret put <NAME>`, not committed here):
	//   ANTHROPIC_API_KEY
	//   ELEVENLABS_API_KEY
	//   NARRATOR_VOICE_ID   — ElevenLabs voice "Oxley — Rich and Deep" (set
	//                         Aug 17, 2026). Set this to Oxley's actual Voice ID
	//                         string (ElevenLabs Voice Library → Oxley → copy
	//                         Voice ID), not the display name.
	//   REFRESH_SECRET      — Bearer token for the manual /refresh endpoint
}